+def test_net_revenue_formula_keeps_accounting_sign_of_discount_when_revenue_sheet_is_built(
+    tmp_path: Path,
+) -> None:
+    # Given: the complete stable PSI fixture set.
+    files = {
+        path.name: path.read_bytes()
+        for path in sorted(FIXTURES.glob("*.xlsx"))
+        if path.name != "malformed_product.xlsx"
+    }
+    # When: the reconciliation build creates an XLSX artifact.
+    result = server.build(files)
+    workbook_path = tmp_path / "psi_sign.xlsx"
+    workbook_path.write_bytes(result["xlsx"])
+    sheet = load_workbook(workbook_path, data_only=False)["Revenue final"]
+    formulas = [
+        sheet.cell(row_no, 27).value
+        for row_no in range(2, sheet.max_row + 1)
+        if sheet.cell(row_no, 27).value
+    ]
+    # Then: no formula clamps the discount, so credit notes keep their negative sign.
+    assert formulas
+    assert all("MAX(" not in str(formula) for formula in formulas)
+    assert all(
+        str(formula) == f"=R{row_no}-U{row_no}-X{row_no}-Y{row_no}"
+        for row_no, formula in enumerate(formulas, 2)
+    )
